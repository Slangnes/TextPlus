{
  "name": "textplus",
  "version": "0.0.1",
  "description": "TextPlus - Modernizing Interactive Fiction Tools",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.reporter=html",
    "test:watch": "vitest --watch",
    "test:all": "npm run lint && npm run test && npm run build",
    "test:core": "vitest run packages/core --coverage --coverage.include=packages/core/src/**",
    "test:author": "vitest run packages/author --coverage --coverage.include=packages/author/src/**",
    "test:map": "vitest run packages/map --coverage --coverage.include=packages/map/src/**",
    "test:convert": "vitest run packages/convert --coverage --coverage.include=packages/convert/src/**",
    "test:workbench": "vitest run packages/workbench --coverage --coverage.include=packages/workbench/src/**",
    "test:e2e": "npm run test:e2e --workspace=@textplus/workbench",
    "workbench": "npm run dev --workspace=@textplus/workbench",
    "lint": "tsc --noEmit",
    "build": "npm run --workspaces build",
    "clean": "node -e \"const fs=require('fs');for(const p of['coverage','dist','packages/core/dist','packages/author/dist','packages/map/dist','packages/convert/dist','packages/demo/dist','packages/workbench/dist','packages/workbench/test-results','packages/workbench/playwright-report'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "interactive-fiction",
    "if",
    "hypertext",
    "parser-if",
    "choose-your-own-adventure",
    "text-adventure"
  ],
  "author": "TextPlus Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.1.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
