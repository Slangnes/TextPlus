{
  "name": "textplus",
  "version": "0.0.1",
  "description": "TextPlus - Modernizing Interactive Fiction Tools",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "npm run test:e2e --workspace=@textplus/workbench",
    "test:all": "npm run lint && npm run build && npm run test:e2e",
    "workbench": "npm run dev --workspace=@textplus/workbench",
    "lint": "tsc --noEmit",
    "build": "npm run --workspaces build",
    "clean": "node -e \"const fs=require('fs');for(const p of['dist','packages/core/dist','packages/author/dist','packages/map/dist','packages/convert/dist','packages/demo/dist','packages/workbench/dist','packages/workbench/test-results','packages/workbench/playwright-report'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "interactive-fiction",
    "if",
    "hypertext",
    "parser-if",
    "choose-your-own-adventure",
    "text-adventure"
  ],
  "author": "TextPlus Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
